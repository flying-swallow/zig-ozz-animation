.{
    .name = .cgltf,
    .version = "0.0.0",
    .fingerprint = 0x100e7fe19a20edfe, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.1158+1d1193aa7",
    // cgltf is a single MIT-licensed header, vendored directly (`cgltf.h`, v1.15)
    // rather than fetched — the build only needs the one file, so vendoring keeps
    // the build offline and deterministic. Update by replacing `cgltf.h`.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "cgltf.h",
        "cgltf_impl.c",
    },
}
